# Local-only values used by `./cicd/bash.sh setup` to configure GitHub Actions.
VPS_ROOT_ACCESS="ssh root@server.example.com"
VPS_PASSWORD=""
VPS_PROJECT_DIR="/var/www/hospital_backend"
VPS_APP_CONTAINER=prod_express_api
