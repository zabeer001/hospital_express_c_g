model Patient {
  id        Int           @id @default(autoincrement())
  name      String
  age       Int
  gender    PatientGender
  phone     String?
  email     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  bookings Booking[]

  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([gender])
  @@index([createdAt])
}
